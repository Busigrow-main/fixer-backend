# ──────────────────────────────────────────────
# Fixxer Backend — Environment Variables Example
# Copy this file to .env and fill in real values
# ──────────────────────────────────────────────

NODE_ENV=development
PORT=3000

# Deployed database, reached through the SSH tunnel on this Mac.
# Start the tunnel before `npm run start:dev`. See docs/local-production-database.md
MONGO_URI=mongodb://127.0.0.1:27018/fixxer

# Required in every environment. The process will not start without it.
# Generate: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Default password for auto-created customer accounts (quick phone login)
DEFAULT_CUSTOMER_PASSWORD=fixxer123

CORS_ORIGIN=http://localhost:3001

# Technician onboarding: set false in production to enforce pincode whitelist
ALLOW_ALL_PINCODES=true

ELASTICSEARCH_NODE=http://localhost:9200

# Cloudinary (AC appliance images — never commit real secrets)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
CLOUDINARY_FOLDER=fixxer/appliances

# Azure Communication Services — email OTP login (no custom domain required)
# Use Azure managed sender first, e.g. DoNotReply@xxxx.azurecomm.net
# See docs/azure-email-otp.md — map your own domain later by changing AZURE_EMAIL_SENDER only
AZURE_COMMUNICATION_CONNECTION_STRING=
AZURE_EMAIL_SENDER=DoNotReply@your-domain.azurecomm.net

# Public site URL used in OTP email links (terms / privacy / warranty)
APP_PUBLIC_URL=http://135.222.40.140

# Optional hosted logo image for the OTP email header (HTTPS URL)
# FIXXER_BRAND_LOGO_URL=https://res.cloudinary.com/your-cloud/image/upload/fixxer-logo.png

# Google Sign-In (OAuth Web client ID — same value as NEXT_PUBLIC_GOOGLE_CLIENT_ID)
# See docs/google-signin.md
GOOGLE_CLIENT_ID=

# 32-byte key for the customer FIXXER CODE (AES-256-GCM). Generate with: openssl rand -base64 32
FIXXER_CODE_KEY=ZkWFjgZGklk0028bJ9qrfsZyMkxW00x2zUw27RKSXeY=
