# Copy to /opt/fixxer/fixer-backend/.env on the server.  chmod 600 .env
NODE_ENV=production
PORT=8081

# Mongo runs in Docker on the same box, published on localhost only
MONGO_URI=mongodb://127.0.0.1:27017/fixxer
ELASTICSEARCH_NODE=http://127.0.0.1:9200

# NEW secrets for prod: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d
DEFAULT_CUSTOMER_PASSWORD=

# In production main.ts allows ONLY these origins (no localhost fallback)
CORS_ORIGIN=https://example.com,https://www.example.com

PAYMENT_WEBHOOK_SECRET=
ALLOW_ALL_PINCODES=false

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=fixxer/appliances

AZURE_COMMUNICATION_CONNECTION_STRING=
AZURE_EMAIL_SENDER=

APP_PUBLIC_URL=https://example.com
GOOGLE_CLIENT_ID=

# Fresh database → generate a NEW key (do NOT reuse the one committed in .env.example):
#   openssl rand -base64 32
FIXXER_CODE_KEY=
